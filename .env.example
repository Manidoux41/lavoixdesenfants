# PostgreSQL connection strings. Use a pooled URL for DATABASE_URL when available
# and a direct/non-pooled URL for DIRECT_URL and Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional provider aliases. Copy their values into DATABASE_URL/DIRECT_URL as appropriate.
POSTGRES_URL="postgres://2a72629c04962178dd006ec838b78ce008011d370eeaa23794f33502f88a89a3:sk_LiUw9fNHC5BeFnQrbABSW@db.prisma.io:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://2a72629c04962178dd006ec838b78ce008011d370eeaa23794f33502f88a89a3:sk_LiUw9fNHC5BeFnQrbABSW@db.prisma.io:5432/postgres?sslmode=require"

# Vercel Blob. Keep tokens server-side; never use a NEXT_PUBLIC_ prefix.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Random secret with at least 32 bytes, used for admin login throttling.
SESSION_SECRET=""

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL="https://example.org"

# Resend contact delivery. CONTACT_FROM must be a verified sender in the Resend account.
