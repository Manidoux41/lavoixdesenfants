# PostgreSQL URLs supplied by the Prisma Postgres integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
POSTGRES_URL=""
PRISMA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Vercel Blob. Keep tokens server-side; never use a NEXT_PUBLIC_ prefix.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Random secret with at least 32 bytes, used for admin login throttling.
SESSION_SECRET=""

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL="https://example.org"

# Resend contact delivery. CONTACT_FROM must be a verified sender in the Resend account.
RESEND_API_KEY=""
CONTACT_EMAIL=""
CONTACT_FROM=""

# Temporary values for the one-time first-admin command; remove them after use.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
